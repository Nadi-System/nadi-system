@article{hallHydrologistsGuideOpen2022,
  title = {A Hydrologist's Guide to Open Science},
  author = {Hall, Caitlyn A. and Saia, Sheila M. and Popp, Andrea L. and Dogulu, Nilay and Schymanski, Stanislaus J. and Drost, Niels and {van Emmerik}, Tim and Hut, Rolf},
  year = {2022},
  month = feb,
  journal = {Hydrology and Earth System Sciences},
  volume = {26},
