@article{slaterUsingHydrologyReview2019a,
  title = {Using {{R}} in Hydrology: A Review of Recent Developments and Future Directions},
  shorttitle = {Using {{R}} in Hydrology},
  author = {Slater, Louise J. and Thirel, Guillaume and Harrigan, Shaun and Delaigue, Olivier and Hurley, Alexander and Khouakhi, Abdou and Prosdocimi, Ilaria and Vitolo, Claudia and Smith, Katie},
