  url = {https://agupubs.onlinelibrary.wiley.com/doi/10.1002/2017WR020861},
  urldate = {2024-02-14},
  abstract = {To sustainably manage water resources, we must understand how to control complex networked systems. In this paper, we study surface water networks from the perspective of structural controllability, a concept that integrates classical control theory with graph-theoretic formalism. We present structural controllability theory and compute four metrics: full and target controllability, control centrality and control profile (FTCP) that collectively determine the structural boundaries of the system's control space. We use these metrics to answer the following questions: How does the structure of a surface water network affect its controllability? How to efficiently control a preselected subset of the network? Which nodes have the highest control power? What types of topological structures dominate controllability? Finally, we demonstrate the structural controllability theory in the analysis of a wide range of surface water networks, such as tributary, deltaic, and braided river systems.},
  langid = {english},
  file = {/home/gaurav/Zotero/storage/3BDNKUSR/Riasi and Yeghiazarian - 2017 - Controllability of Surface Water Networks.pdf}
}

@article{rodriguez-iturbeRiverNetworksEcological2009,
  title = {River Networks as Ecological Corridors: {{A}} Complex Systems Perspective for Integrating Hydrologic, Geomorphologic, and Ecologic Dynamics},
