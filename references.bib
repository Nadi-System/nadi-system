@article{gironasNewApplicationsManual2010,
  title = {A New Applications Manual for the {{Storm Water Management Model}} ({{SWMM}})},
  author = {Giron{\'a}s, Jorge and Roesner, Larry and Rossman, Lewis and Davis, Jennifer},
