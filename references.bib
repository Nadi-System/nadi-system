  journal = {Environmental Modelling \& Software},
  volume = {122},
  pages = {104538},
  issn = {1364-8152},
  doi = {10.1016/j.envsoft.2019.104538},
  url = {https://www.sciencedirect.com/science/article/pii/S1364815219301975},
  urldate = {2025-05-02},
  abstract = {Developing simulation and optimisation models for resource networks like water or energy systems increasingly involves integrating multiple data sources and software. Connecting multiple models and managing data accessed by different groups of analysts is a software challenge. Many resource systems are represented in computer models as networks of nodes and links, driven by a range of objectives and rules. We present a data storage platform, written in Python, which exploits the commonality of network representations to store data for multiple model types within a single deployment. This open-source platform provides a common source of data to multiple models using consistent data formats, reducing likelihood of error compared to file based data management. When deployed as a web service, it allows data to be shared securely among authorised users over the internet, facilitating collaboration. A case study describes the hosting of a water utility planning model, with an accompanying worked example.},
  keywords = {Model platform,Network modelling,Open source,Python,Software framework,Web services},
  file = {/home/gaurav/Zotero/storage/CEQ5QNG5/Knox et al. - 2019 - An open-source data manager for network models.pdf;/home/gaurav/Zotero/storage/JH4YWNLD/S1364815219301975.html}
}

