# load network
network load_file("scioto-gage.network")

network csv.load_timeseries("scioto.csv", "date", "streamflow");
node ts_complete("streamflow")
node.data_frac =  ts_len("streamflow", valid=true) / ts_len("streamflow");
node.good = data_frac > 0.75;


network gis.fields("/home/gaurav/work/nadi-project/analysis/data/gagesII_9322_point_shapefile.shp.zip")
network gis.load_attrs("/home/gaurav/work/nadi-project/analysis/data/usgs-drainage.csv", "SiteNumber")
network gis.load_attrs("/home/gaurav/work/nadi-project/analysis/data/gagesII_9322_point_shapefile.shp.zip", "STAID")
network gis.load_attrs("/home/gaurav/work/nadi-project/analysis/data/usgs-gages-stat.csv", "Site Number")

node(DRAIN_SQKM?).area = DRAIN_SQKM;
node(Drainage?).area = float(node.Drainage) * 2.5899881;

node.visual.nodeshape = "circle";
node(good).visual.nodecolor = "blue";
node(good).visual.textcolor = "blue";
network set_nodesize_attrs(nodes.area, maxsize=8.0);
network svg.ts_blocks("test.svg", "{NAME}", "streamflow", 500.0, 380.0, svg.settings(top=25.0, deltax=10.0))
network typst.svg2pdf("test.svg", "/tmp/test.pdf")

# node<inp>.gcarea = if (good) {area} else { sum(inputs.garea)};
# node.ratio = gcarea / area;
# node.dratio = r"{ratio:.4}";

node.darea = r"{area:.1}";
node.data = r"{data_frac:.4}";
node[03227500].area = 3000.0
node.area_check = area >= sum(inputs.area);
node.area_valid = if (area_check) {"✓"} else {"✗"};
node(!area_check).visual.nodecolor = "red";
network typst.compile(typst.table("
Index => {INDEX}
USGS ID => {NAME}
<Name => {Site_Name}
>Area ($\"km\"^2$) => {darea}
Area Check => {area_valid}
Data Fraction => {data}
"), "/tmp/table.pdf")

exit
# simple loop
env.count = 1;
while (count < 5) {
    env.count = env.count + 1;
    env.count
}

# output not being available should be checked as well?
node output.INDEX?
node(output.INDEX?) output.INDEX == (node.INDEX - 1)
# load average streamflow from the csv file containing timeseries using python
node command("python area-and-streamflow.py {_NAME}")

env.nodesize = 5
node.visual.nodesize = env.nodesize

network count()
env count(nodes.area?)
# there were some nodes without area in the original network, remove those nodes
network subset(nodes.area?)

# visualize size based on area
network set_nodesize_attrs(nodes.area, maxsize=8)
node(area > 500).visual.nodecolor = "orange";

node.nodelabel = "i={INDEX}; xi = {area:f(2)?\"N/A\"}; yi = {streamflow:f(2)}"

network save_file("updated.network")
# network export_svg("network.svg")

node.INDEX
node(INDEX>0).output_ind = output_attr("INDEX")

# the following two lines are a complex template example, I used this to generate a table in LaTeX
network render_nodes("\\Node[{LEVEL}]\\{{INDEX}\\}\\{{INDEX}\\} & Node {INDEX} & {area:f(2)?} & {streamflow:f(2)?} \\\\[2mm]")
node(INDEX>0) render("({INDEX}) edge ({output_ind})")

# this just prints the attributes in csv format.
# writing it to file and other functions are to be added
network print_attr_csv("INDEX", "area", "streamflow")
