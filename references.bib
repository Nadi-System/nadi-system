@book{rossmanOpenSourcingEPANET2010,
  title = {The Open Sourcing of {{EPANET}}},
  author = {Rossman, Lewis and Van Zyl, Jakobus},
  year = {2010},
  month = jan,
  journal = {Water Distribution Systems Analysis 2010 - Proceedings of the 12th International Conference, WDSA 2010},
  doi = {10.1061/41203(425)4},
  abstract = {The public domain EPANET software developed by Dr. Lewis Rossman (2000) has become the standard tool for water distribution systems research, and its hydraulics engine is used by many commercial modeling packages. In his WDSA 2009 keynote address at the EWRI Congress in Kansas City, Dr. Rossman proposed an open source model for EPANET. Such an open source model will allow different programmers to collaboratively modify and extend the EPANET source code. The purpose of this paper is to explore the advantages and disadvantages of procedural and object-oriented programming styles for an EPANET open source project. The current EPANET core engine is written in highly efficient procedural code, which is difficult for a new programmer to understand and modify, and not conducive to collaborative development. Object-oriented EPANET code will be more amenable to a collaborative development, but will introduce processing overheads that will reduce the computational efficiency of simulations. A third possibility is to use a mix of programming styles, using object-oriented code to represent the network structure, and procedural code to do the hydraulic network calculations. It is hoped that this paper will inform and contribute to the debate on an EPANET open source project.}
}

