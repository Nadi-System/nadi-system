@article{demirOptimizationRiverNetwork2017,
  title = {Optimization of River Network Representation Data Models for Web-Based Systems},
  author = {Demir, Ibrahim and Szczepanek, Robert},
  year = {2017},
  journal = {Earth and Space Science},
  volume = {4},
  number = {6},
  pages = {336--347},
  issn = {2333-5084},
  doi = {10.1002/2016EA000224},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/2016EA000224},
  urldate = {2025-04-17},
  abstract = {Web-based systems allow users to filter data and resources using river network structure on interactive map environments that use server side processing. With the increasing resolution of river networks, optimized methods for storage of river network representation in databases and efficient queries on the river network structure become critical. This paper presents a detailed study of widely used methods for representing generic networks in relational databases and benchmarking common queries on river network data using these methods. The analysis has been applied to a data set consisting of the river network of Iowa, with over 620,000 individual subwatersheds/nodes in the network. For typical river network queries (path to the outlet; contributing watersheds), two of considered data models (Adjacency List and Nested Set) guarantee response times below 1 s. This will allow users to carry out large-scale analysis and visualizations tasks on the web for hydrological data sets. A new data model, Stream Network, is proposed based on Path Enumeration, stores directly additional hydrological information, enabling, for example, retrieval of the main stream.},
  copyright = {{\copyright}2017. The Authors.},
  langid = {english},
  keywords = {data management,data representation,databases,hydrology,informatics,network models},
  file = {/home/gaurav/Zotero/storage/F6T9QZRC/Demir and Szczepanek - 2017 - Optimization of river network representation data models for web-based systems.pdf;/home/gaurav/Zotero/storage/QX5TXAV4/2016EA000224.html}
}

