@article{guttmanRtreesDynamicIndex1984,
  title = {R-Trees: A Dynamic Index Structure for Spatial Searching},
  shorttitle = {R-Trees},
  author = {Guttman, Antonin},
  year = {1984},
  month = jun,
  journal = {SIGMOD Rec.},
