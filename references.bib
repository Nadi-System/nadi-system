@article{heveyNetworkAnalysisBrief2018,
  title = {Network Analysis: A Brief Overview and Tutorial},
  shorttitle = {Network Analysis},
  author = {Hevey, David},
  year = {2018},
  month = sep,
  journal = {Health Psychology and Behavioral Medicine},
  volume = {6},
  number = {1},
